<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PSPVideoConverterTool"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="PSPVideoConverterTool.UI_Converter"
        mc:Ignorable="d"
        Title="PSP Video Converter Tool v3.0" Height="613" Width="718" WindowStartupLocation="CenterScreen" WindowStyle="ThreeDBorderWindow" Background="White" MinWidth="718" MinHeight="613" ResizeMode="CanMinimize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="718"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Output folder path" HorizontalAlignment="Left" Margin="46,107,0,0" VerticalAlignment="Top" Foreground="#FF066FAE"/>
        <ui:Button x:Name="btn_set_output" Icon="{ui:SymbolIcon FolderOpenVertical20}" Content="Select" Margin="0,135,73,0" VerticalAlignment="Top" Height="36" Background="White" Click="set_output" Cursor="Hand" HorizontalAlignment="Right" Width="92"/>
        <Label Content="Extra options"  HorizontalAlignment="Left" Margin="46,194,0,0" VerticalAlignment="Top" Foreground="#FF066FAE"/>
        <CheckBox x:Name="thumbnail_option" Content="Generate thumbnail" Margin="60,226,0,0" IsChecked="True" Cursor="Hand" Foreground="#E4000000" VerticalAlignment="Top"/>
        <ui:Button x:Name="btn_info" Icon="{ui:SymbolIcon Info24}"  Content="" Margin="46,0,0,51" VerticalAlignment="Bottom" Width="39" Background="White" Click="show_info" Cursor="Hand" Appearance="Info" Foreground="Black" Height="36"/>

        <Label Content="Input folder path" HorizontalAlignment="Left" Margin="46,19,0,0" VerticalAlignment="Top" Foreground="#FF066FAE"/>
        <ui:TextBox x:Name="output_path" Icon="{ui:SymbolIcon FolderMail16}" Margin="46,135,170,0" TextWrapping="Wrap" VerticalAlignment="Top" MinWidth="502" PlaceholderText="Put the output path where converted files will be stored..." HorizontalScrollBarVisibility="Hidden"/>
        <ui:TextBox x:Name="input_path" Icon="{ui:SymbolIcon Document28}" VerticalAlignment="Top" PlaceholderText="Put the input path where the files are located..." OverridesDefaultStyle="True" SnapsToDevicePixels="True" Margin="46,47,170,0" MinWidth="502"/>
        <ui:Button x:Name="btn_select_input" Icon="{ui:SymbolIcon FolderOpenVertical20}" Content="Select" Margin="0,47,73,0" VerticalAlignment="Top" Click="set_input" Height="36" Cursor="Hand" HorizontalAlignment="Right" Width="92"/>
        <ui:Button x:Name="convert" Icon="{ui:SymbolIcon ArchiveSettings24}" Appearance="Primary" Content="Convert" Margin="0,0,59,46" VerticalAlignment="Bottom" Click="convert_video" Cursor="Hand" HorizontalAlignment="Right" Width="217" Height="51"/>
        <ui:FontIcon HorizontalAlignment="Left" Height="100" Margin="410,395,0,0" VerticalAlignment="Top" Width="100"/>
        <ui:TextBox x:Name="log" Margin="46,315,59,145" TextWrapping="Wrap" MinHeight="137" MinWidth="613" Focusable="False"/>
        <ui:Anchor Icon="{ui:SymbolIcon Link24}" Content="GitHub repository" NavigateUri="https://github.com/Rammaken/PSPVideoConverterTool"  Margin="94,510,0,0" VerticalAlignment="Top" Width="168" Height="36"/>
        <ProgressBar x:Name="status_progress" Margin="46,0,59,110" Height="13" VerticalAlignment="Bottom"/>
        <CheckBox x:Name="output_open_option" Content="Open output folder when finished" Margin="240,226,0,0" VerticalAlignment="Top"/>
        <Label Content="Log"  HorizontalAlignment="Left" Margin="46,0,0,0" VerticalAlignment="Center" Foreground="#FF066FAE"/>
        <CheckBox x:Name="console_option" Content="Show console" Margin="506,226,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>

