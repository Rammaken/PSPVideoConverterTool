<Window x:Class="PSPVideoConverterTool.UI_Converter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PSPVideoConverterTool"
        mc:Ignorable="d"
        Title="PSP Video Converter Tool v2.0" Height="468" Width="684" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Content="Input folder path" HorizontalAlignment="Left" Margin="45,26,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="input_path" HorizontalAlignment="Left" Margin="45,52,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="503" Height="24"/>
        <Label Content="Output path folder" HorizontalAlignment="Left" Margin="45,86,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="output_path" HorizontalAlignment="Left" Margin="45,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="503" Height="24"/>
        <Button x:Name="input_set" Content="Select" HorizontalAlignment="Left" Margin="553,52,0,0" VerticalAlignment="Top" Height="24" Width="73" Background="White" Click="set_input" Cursor="Hand"/>
        <Button x:Name="output_set" Content="Select" HorizontalAlignment="Left" Margin="553,112,0,0" VerticalAlignment="Top" Height="24" Width="73" Background="White" Click="set_output" Cursor="Hand"/>
        <TextBox x:Name="log" Margin="45,0,58,104" TextWrapping="Wrap" VerticalAlignment="Bottom" Height="91" IsEnabled="False"/>
        <Separator Margin="0,365,0,0" VerticalAlignment="Top" Height="11"/>
        <Button x:Name="convert" Content="Convert" Margin="553,386,0,0" Background="White" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="103" Click="convert_video" Cursor="Hand"/>
        <Label Content="Extra options" HorizontalAlignment="Left" Margin="46,152,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="thumbnail_option" Content="Generate thumbnail" HorizontalAlignment="Left" Margin="60,183,0,0" VerticalAlignment="Top" IsChecked="True" Cursor="Hand"/>
        <Label Content="Log" HorizontalAlignment="Left" Margin="45,0,0,0" VerticalAlignment="Center"/>
        <Button x:Name="btn_info" Content="?" HorizontalAlignment="Left" Margin="20,386,0,0" VerticalAlignment="Top" Height="30" Width="24" Background="White" Click="show_info" Cursor="Hand"/>

    </Grid>

</Window>
